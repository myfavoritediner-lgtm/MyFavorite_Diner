# ---------------------------------------------------------------
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real keys.
# ---------------------------------------------------------------

# ============ SUPABASE ============
# Supabase dashboard -> Project Settings -> API

# Safe to expose in the browser — it ends up in the JavaScript either way.
# New projects issue this as sb_publishable_…; older ones use a long JWT
# beginning eyJ. Both work. Take both keys from the same project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SECRET — server only, and it bypasses every row level security policy.
# Used for one-click unsubscribe links and the activity log.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx


# ============ EMAIL (Resend) ============
# Sign up free at resend.com, then: API Keys -> Create API Key

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address. Must be on a domain you have verified in Resend.
#
# onboarding@resend.dev is fine while you are still testing, but Resend only
# delivers from it to the address that owns your Resend account — every mail
# to a real guest is rejected. Verify your domain before you take bookings.
EMAIL_FROM=My Favorite Diner <hello@myfavoritediner.com>

# Where guest replies go (optional but recommended). Without it, a guest who
# replies to their confirmation is answering a no-reply address.
EMAIL_REPLY_TO=hello@myfavoritediner.com

# Gets an email whenever someone books a table.
# Leave blank to use the address set in Admin -> Settings. If this AND that
# field are both blank AND LINE is not set up, a booking is saved and nobody
# is told about it — Admin -> Home reports that in red.
ADMIN_NOTIFY_EMAIL=


# ============ LINE (booking alerts) ============
# Optional but recommended — a card in your staff LINE group the moment a
# table is requested. LINE Notify was shut down in March 2025; this uses the
# Messaging API instead. See the LINE section of the README for setup.

# LINE Developers Console -> your channel -> Messaging API -> issue a
# long-lived channel access token. SECRET, server only.
LINE_CHANNEL_ACCESS_TOKEN=

# Same channel -> Basic settings -> Channel secret. Used to verify that
# webhook calls really came from LINE. SECRET, server only.
LINE_CHANNEL_SECRET=

# Where alerts go. Add the bot to your staff group and send "id" — it will
# reply with the value to paste here. Comma-separate to notify more than one.
LINE_TARGET_ID=


# ============ SITE ============
# Used to build links inside emails AND every SEO URL (sitemap, canonical,
# structured data). Set this to your real domain in production.
#
# Left as localhost on the live site, the cancel and unsubscribe links you
# email to guests point at their own computer, every SEO URL is wrong, and
# the LINE card drops its admin button (LINE will not accept an http link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ============ SEO (optional) ============
# From Google Search Console -> Add property -> HTML tag.
# Paste only the content value, e.g. abc123xyz
GOOGLE_SITE_VERIFICATION=


# ============ HOUSEKEEPING ============
# Signs the nightly purge job at /api/cron/purge, which deletes bookings
# past the retention window and forgets people who unsubscribed long ago.
# Vercel sets this header on its own cron calls; without it the route is
# refused in production. Generate any long random string.
CRON_SECRET=
